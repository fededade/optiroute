# ============================================
# OptiRoute - Variabili d'ambiente
# ============================================

# --- Frontend (Vite: prefisso VITE_, visibili nel browser) ---

# Webhook n8n per l'invio del report Excel (opzionale, ha un default nel codice)
VITE_N8N_WEBHOOK_URL=

# Chiave Gemini per la pulizia AI degli indirizzi in inserimento rapido (opzionale:
# senza chiave l'indirizzo viene usato così com'è)
VITE_GEMINI_API_KEY=

# --- Backend / Vercel Serverless (mai esposte al browser) ---

# Google Maps Directions (già usata da api/directions.ts)
GOOGLE_MAPS_API_KEY=

# Retell AI - chiamata di conferma appuntamento (api/retell-call.ts)
# API key dalla dashboard Retell (https://dashboard.retellai.com -> API Keys)
RETELL_API_KEY=

# Numero telefonico in uscita acquistato/importato su Retell, formato E.164 (es. +39...)
RETELL_FROM_NUMBER=

# (Opzionale) ID dell'agente Retell da usare per la chiamata; se omesso viene
# usato l'agente in uscita associato al numero
RETELL_AGENT_ID=

# (Opzionale) Nome dell'azienda pronunciato dall'operatore AI
RETELL_COMPANY_NAME=

# (Opzionale) Base dell'API Retell: solo per puntare a un Retell finto nei test
# o con scripts/dev-cloud-server.mjs (default https://api.retellai.com)
RETELL_API_BASE=

# --- Pilota in cloud (api/cloud.js, api/cloud-tick.js) ---

# Chiave unica del cloud: la invia lo scheduler di Vercel (Authorization:
# Bearer) e la inserisce l'operatore nelle impostazioni del browser. Se è
# impostata protegge anche api/retell-call e api/call-status. Stringa lunga e
# casuale (es. openssl rand -hex 32). Senza, le API cloud rispondono 503.
CRON_SECRET=

# Database Upstash Redis (integrazione Marketplace di Vercel): una delle due
# coppie. Se presenti entrambe vincono le UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (Opzionale) Fuso orario del motore (default Europe/Rome)
OPTIROUTE_TZ=

# (Opzionale) Destinazione della sync col gestionale anche per il motore lato
# server: production | staging (default staging)
VITE_SYNC_ENV=

# (Solo sviluppo locale, ignorata su Vercel) archivio in memoria
# OPTIROUTE_STORE=memory

# (Opzionale) Sync col gestionale dal motore lato server: off per spegnerla.
# Con l'archivio in memoria è spenta salvo OPTIROUTE_SYNC=on.
OPTIROUTE_SYNC=
